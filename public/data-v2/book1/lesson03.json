        {
          "speaker": "B",
          "chinese": "不，学汉语。",
          "pinyin": "Bù, xué Hànyǔ.",
          "vietnamese": "Không, học tiếng Hán.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "A",
          "chinese": "去北京吗？",
          "pinyin": "Qù Běijīng ma?",
          "vietnamese": "Đi Bắc Kinh à?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "B",
          "chinese": "对。",
          "pinyin": "Duì.",
          "vietnamese": "Đúng.",
          "pinyinStatus": "existing_curated"
        }
      ],
      "sourceVerified": true
    },
    {
      "id": "b1_l03_d02",
      "title": "明天见",
      "lines": [
        {
          "speaker": "A",
          "chinese": "你去邮局寄信吗？",
          "pinyin": "Nǐ qù yóujú jì xìn ma?",
          "vietnamese": "Bạn đi bưu điện gửi thư à?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "B",
          "chinese": "不去。去银行取钱。",
          "pinyin": "Bù qù. Qù yínháng qǔ qián.",
          "vietnamese": "Không đi. Đi ngân hàng rút tiền.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "A",
          "chinese": "明天见！",
          "pinyin": "Míngtiān jiàn!",
          "vietnamese": "Ngày mai gặp lại!",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "B",
          "chinese": "明天见！",
          "pinyin": "Míngtiān jiàn!",
          "vietnamese": "Ngày mai gặp lại!",
