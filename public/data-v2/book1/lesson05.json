  "dialogues": [
    {
      "id": "b1_l05_d01",
      "title": "这是王老师",
      "lines": [
        {
          "speaker": "A",
          "chinese": "这是王老师，这是我爸爸。",
          "pinyin": "Zhè shì Wáng lǎoshī, zhè shì wǒ bàba.",
          "vietnamese": "Đây là thầy giáo Vương, đây là bố tôi.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "B",
          "chinese": "王老师，您好！",
          "pinyin": "Wáng lǎoshī, nín hǎo!",
          "vietnamese": "Thầy Vương, xin chào!",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "C",
          "chinese": "您好！请进！请坐！请喝茶！",
          "pinyin": "Nín hǎo! Qǐng jìn! Qǐng zuò! Qǐng hē chá!",
          "vietnamese": "Xin chào! Mời vào! Mời ngồi! Mời uống trà!",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "B",
          "chinese": "谢谢！",
          "pinyin": "Xièxie!",
          "vietnamese": "Cảm ơn!",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "C",
          "chinese": "不客气！",
          "pinyin": "Bú kèqi!",
          "vietnamese": "Không có gì!",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "C",
          "chinese": "工作忙吗？",
          "pinyin": "Gōngzuò máng ma?",
          "vietnamese": "Công việc bận không?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "B",
          "chinese": "不太忙。",
          "pinyin": "Bú tài máng.",
          "vietnamese": "Không bận lắm.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "C",
          "chinese": "身体好吗？",
          "pinyin": "Shēntǐ hǎo ma?",
          "vietnamese": "Sức khỏe tốt không?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "B",
          "chinese": "很好！",
          "pinyin": "Hěn hǎo!",
          "vietnamese": "Rất tốt!",
          "pinyinStatus": "existing_curated"
        }
      ],
      "sourceVerified": true
    }
  ],
