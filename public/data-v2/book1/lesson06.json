  "dialogues": [
    {
      "id": "b1_l06_d01",
      "title": "我学习汉语",
      "lines": [
        {
          "speaker": "麦克",
          "chinese": "请问，你贵姓？",
          "pinyin": "Qǐngwèn, nǐ guìxìng?",
          "vietnamese": "Xin hỏi, quý danh của bạn là gì?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "张东",
          "chinese": "我姓张。",
          "pinyin": "Wǒ xìng Zhāng.",
          "vietnamese": "Tôi họ Trương.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "麦克",
