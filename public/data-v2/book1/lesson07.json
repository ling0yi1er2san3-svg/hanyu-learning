  "dialogues": [
    {
      "id": "b1_l07_d01",
      "title": "在教室",
      "lines": [
        {
          "speaker": "麦克",
          "chinese": "中午你去哪儿吃饭？",
          "pinyin": "Zhōngwǔ nǐ qù nǎr chī fàn?",
          "vietnamese": "Buổi trưa bạn đi đâu ăn cơm?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "玛丽",
          "chinese": "我去食堂。",
          "pinyin": "Wǒ qù shítáng.",
          "vietnamese": "Tôi đi nhà ăn.",
          "pinyinStatus": "existing_curated"
        }
      ],
      "sourceVerified": true
    },
    {
      "id": "b1_l07_d02",
      "title": "在食堂",
      "lines": [
        {
          "speaker": "麦克",
          "chinese": "你吃什么？",
          "pinyin": "Nǐ chī shénme?",
          "vietnamese": "Bạn ăn gì?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "玛丽",
          "chinese": "我吃馒头。",
          "pinyin": "Wǒ chī mántou.",
          "vietnamese": "Tôi ăn màn thầu.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "麦克",
          "chinese": "你要几个？",
          "pinyin": "Nǐ yào jǐ ge?",
          "vietnamese": "Bạn muốn mấy cái?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "玛丽",
          "chinese": "一个。你吃吗？",
          "pinyin": "Yí ge. Nǐ chī ma?",
          "vietnamese": "Một cái. Bạn ăn không?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "麦克",
          "chinese": "不吃，我吃米饭。你喝什么？",
          "pinyin": "Bù chī, wǒ chī mǐfàn. Nǐ hē shénme?",
          "vietnamese": "Không ăn, tôi ăn cơm. Bạn uống gì?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "玛丽",
          "chinese": "我要一碗鸡蛋汤。你喝吗？",
          "pinyin": "Wǒ yào yì wǎn jīdàn tāng. Nǐ hē ma?",
          "vietnamese": "Tôi muốn một bát canh trứng. Bạn uống không?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "麦克",
          "chinese": "不喝，我喝啤酒。",
          "pinyin": "Bù hē, wǒ hē píjiǔ.",
          "vietnamese": "Không uống, tôi uống bia.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "玛丽",
          "chinese": "这些是什么？",
          "pinyin": "Zhèxiē shì shénme?",
          "vietnamese": "Những cái này là gì?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "麦克",
          "chinese": "这是饺子，这是包子，那是面条。",
          "pinyin": "Zhè shì jiǎozi, zhè shì bāozi, nà shì miàntiáo.",
          "vietnamese": "Đây là bánh chẻo, đây là bánh bao, kia là mì sợi.",
          "pinyinStatus": "existing_curated"
        }
      ],
      "sourceVerified": true
    }
  ],
