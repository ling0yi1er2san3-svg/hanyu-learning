  "dialogues": [
    {
      "id": "b1_l08_d01",
      "title": "买水果",
      "lines": [
        {
          "speaker": "A",
          "chinese": "你买什么？",
          "pinyin": "Nǐ mǎi shénme?",
          "vietnamese": "Bạn mua gì?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "B",
          "chinese": "我买水果。苹果一斤多少钱？",
          "pinyin": "Wǒ mǎi shuǐguǒ. Píngguǒ yì jīn duōshao qián?",
          "vietnamese": "Tôi mua hoa quả. Một cân táo bao nhiêu tiền?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "A",
          "chinese": "三块。",
          "pinyin": "Sān kuài.",
          "vietnamese": "Ba đồng.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "B",
          "chinese": "三块？太贵了。两块五吧。",
          "pinyin": "Sān kuài? Tài guì le. Liǎng kuài wǔ ba.",
          "vietnamese": "Ba đồng? Đắt quá. Hai đồng rưỡi nhé.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "A",
          "chinese": "你要几斤？",
          "pinyin": "Nǐ yào jǐ jīn?",
          "vietnamese": "Bạn muốn mấy cân?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "B",
          "chinese": "我要五斤。",
          "pinyin": "Wǒ yào wǔ jīn.",
          "vietnamese": "Tôi muốn năm cân.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "A",
          "chinese": "还要别的吗？",
          "pinyin": "Hái yào biéde ma?",
          "vietnamese": "Còn muốn thứ khác không?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "B",
          "chinese": "橘子怎么卖？",
          "pinyin": "Júzi zěnme mài?",
          "vietnamese": "Quýt bán thế nào?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "A",
          "chinese": "两块。",
          "pinyin": "Liǎng kuài.",
          "vietnamese": "Hai đồng.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "B",
          "chinese": "要两斤。一共多少钱？",
          "pinyin": "Yào liǎng jīn. Yígòng duōshao qián?",
          "vietnamese": "Lấy hai cân. Tổng cộng bao nhiêu tiền?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "A",
          "chinese": "一共十六块五（毛）。你给十六块吧。",
          "pinyin": "Yígòng shíliù kuài wǔ (máo). Nǐ gěi shíliù kuài ba.",
          "vietnamese": "Tổng cộng mười sáu đồng năm hào. Bạn đưa mười sáu đồng thôi.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "B",
          "chinese": "给你钱。",
          "pinyin": "Gěi nǐ qián.",
          "vietnamese": "Đưa bạn tiền.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "A",
          "chinese": "这是五十，我找您三十四块。",
          "pinyin": "Zhè shì wǔshí, wǒ zhǎo nín sānshísì kuài.",
          "vietnamese": "Đây là năm mươi, tôi trả lại ngài ba mươi bốn đồng.",
          "pinyinStatus": "existing_curated"
        }
      ],
      "sourceVerified": true
    }
  ],
