  "dialogues": [
    {
      "id": "b1_l09_d01",
      "title": "我换人民币",
      "lines": [
        {
          "speaker": "玛丽",
          "chinese": "下午我去图书馆，你去不去？",
          "pinyin": "Xiàwǔ wǒ qù túshūguǎn, nǐ qù bu qù?",
          "vietnamese": "Buổi chiều tôi đi thư viện, bạn có đi không?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "麦克",
          "chinese": "我不去，我要去银行换钱。",
          "pinyin": "Wǒ bú qù, wǒ yào qù yínháng huàn qián.",
          "vietnamese": "Tôi không đi, tôi muốn đi ngân hàng đổi tiền.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "麦克",
          "chinese": "小姐，我换钱。",
          "pinyin": "Xiǎojiě, wǒ huàn qián.",
          "vietnamese": "Cô ơi, tôi đổi tiền.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "营业员",
          "chinese": "您换什么钱？",
          "pinyin": "Nín huàn shénme qián?",
          "vietnamese": "Ngài đổi tiền gì?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "麦克",
          "chinese": "我换人民币。",
          "pinyin": "Wǒ huàn rénmínbì.",
          "vietnamese": "Tôi đổi nhân dân tệ.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "营业员",
          "chinese": "换多少？",
          "pinyin": "Huàn duōshao?",
          "vietnamese": "Đổi bao nhiêu?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "麦克",
          "chinese": "二百美元。",
          "pinyin": "Èr bǎi měiyuán.",
          "vietnamese": "Hai trăm đô la Mỹ.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "营业员",
          "chinese": "请等一会儿……先生，给您钱。请数数。",
          "pinyin": "Qǐng děng yíhuìr... Xiānsheng, gěi nín qián. Qǐng shǔshu.",
          "vietnamese": "Xin đợi một lát... Thưa ông, tiền của ông đây. Xin đếm lại.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "麦克",
          "chinese": "对了。谢谢！",
          "pinyin": "Duì le. Xièxie!",
          "vietnamese": "Đúng rồi. Cảm ơn!",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "营业员",
          "chinese": "不客气！",
          "pinyin": "Bú kèqi!",
          "vietnamese": "Không có gì!",
          "pinyinStatus": "existing_curated"
        }
      ],
      "sourceVerified": true
    }
  ],
