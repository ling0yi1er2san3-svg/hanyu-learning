  "texts": [],
  "dialogues": [
    {
      "id": "b1_l10_d01",
      "title": "他住哪儿",
      "lines": [
        {
          "speaker": "李昌浩",
          "chinese": "请问，这是办公室吗？",
          "pinyin": "Qǐngwèn, zhè shì bàngōngshì ma?",
          "vietnamese": "Xin hỏi, đây là văn phòng phải không?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "职员",
          "chinese": "是。你找谁？",
          "pinyin": "Shì. Nǐ zhǎo shéi?",
          "vietnamese": "Phải. Bạn tìm ai?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "李昌浩",
          "chinese": "王老师在哪儿？我是他的学生。",
          "pinyin": "Wáng lǎoshī zài nǎr? Wǒ shì tā de xuésheng.",
          "vietnamese": "Thầy Vương ở đâu? Tôi là học sinh của thầy.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "职员",
          "chinese": "他不在。他在家呢。",
          "pinyin": "Tā bú zài. Tā zài jiā ne.",
          "vietnamese": "Ông ấy không có ở đây. Ông ấy ở nhà.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "李昌浩",
          "chinese": "他住哪儿？",
          "pinyin": "Tā zhù nǎr?",
          "vietnamese": "Ông ấy ở đâu?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "职员",
          "chinese": "他住十八楼一门，房间号是601。",
          "pinyin": "Tā zhù shíbā lóu yī mén, fángjiān hào shì liù líng yī.",
          "vietnamese": "Ông ấy ở tầng 18, cửa số 1, số phòng 601.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "李昌浩",
          "chinese": "您知道他的电话号码吗？",
          "pinyin": "Nín zhīdào tā de diànhuà hàomǎ ma?",
          "vietnamese": "Ngài biết số điện thoại của ông ấy không?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "职员",
          "chinese": "知道，62931074。",
          "pinyin": "Zhīdào, liù èr jiǔ sān yī líng qī sì.",
          "vietnamese": "Biết, 62931074.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "李昌浩",
          "chinese": "他的手机号码是多少？",
          "pinyin": "Tā de shǒujī hàomǎ shì duōshao?",
          "vietnamese": "Số điện thoại di động của ông ấy là bao nhiêu?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "职员",
          "chinese": "不知道。",
          "pinyin": "Bù zhīdào.",
          "vietnamese": "Không biết.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "李昌浩",
          "chinese": "谢谢您。",
          "pinyin": "Xièxie nín.",
          "vietnamese": "Cảm ơn ngài.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "职员",
          "chinese": "不客气。",
          "pinyin": "Bú kèqi.",
          "vietnamese": "Không có gì.",
          "pinyinStatus": "existing_curated"
        }
      ],
      "sourceVerified": true
    }
  ],
  "grammar": [
    {
      "id": "b1_l10_g01",
      "pattern": "汉语句子的语序",
      "explanationVi": "Trật tự câu tiếng Hán nhìn chung là chủ ngữ + vị ngữ; tân ngữ thường theo sau động từ, định ngữ đứng trước trung tâm ngữ và trạng ngữ đứng trước động từ/tính từ.",
      "sourceVerified": true
    },
    {
      "id": "b1_l10_g02",
      "pattern": "动词谓语句",
      "explanationVi": "Câu vị ngữ động từ là câu có động từ làm thành phần chính của vị ngữ.",
      "sourceVerified": true
    },
    {
      "id": "b1_l10_g03",
      "pattern": "号码的读法",
      "explanationVi": "Khi đọc số điện thoại, số nhà, số hộ chiếu..., từng chữ số thường được đọc tách rời; “一” thường đọc yāo trong dãy số.",
      "sourceVerified": true
    }
  ],
  "usage": [
    {
      "id": "b1_l10_u01",
      "pattern": "请问……？",
      "explanationVi": "Khi hỏi người lạ hoặc hỏi lịch sự, thường mở đầu bằng 请问.",
      "sourceVerified": true
    },
    {
      "id": "b1_l10_u02",
      "pattern": "他在家呢",
      "explanationVi": "呢 ở cuối câu trần thuật có thể biểu thị sắc thái xác nhận hoặc tình trạng đang tiếp diễn.",
      "sourceVerified": true
    },
    {
      "id": "b1_l10_u03",
      "pattern": "您",
      "explanationVi": "Đại từ nhân xưng kính ngữ dùng để xưng hô lịch sự.",
      "sourceVerified": true
    },
    {
      "id": "b1_l10_u04",
      "pattern": "“〇”",
      "explanationVi": "Số 0 trong tiếng Hán đọc líng và có thể viết là 零 hoặc 〇.",
      "sourceVerified": true
    }
  ],
