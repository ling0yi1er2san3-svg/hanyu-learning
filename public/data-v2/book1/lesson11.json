  "texts": [],
  "dialogues": [
    {
      "id": "b1_l11_d01",
      "title": "这位是王教授",
      "lines": [
        {
          "speaker": "秘书",
          "chinese": "我先介绍一下儿，这位是王教授。",
          "pinyin": "Wǒ xiān jièshào yíxiàr, zhè wèi shì Wáng jiàoshòu.",
          "vietnamese": "Tôi xin giới thiệu một chút, vị này là giáo sư Vương.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "校长",
          "chinese": "欢迎您，王教授。",
          "pinyin": "Huānyíng nín, Wáng jiàoshòu.",
          "vietnamese": "Hoan nghênh ngài, giáo sư Vương.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "王教授",
          "chinese": "谢谢！",
          "pinyin": "Xièxie!",
          "vietnamese": "Cảm ơn!",
          "pinyinStatus": "existing_curated"
        }
      ],
      "sourceVerified": true
    },
    {
      "id": "b1_l11_d02",
      "title": "我们都是留学生",
      "lines": [
        {
          "speaker": "田芳",
          "chinese": "你是留学生吗？",
          "pinyin": "Nǐ shì liúxuéshēng ma?",
          "vietnamese": "Bạn là lưu học sinh phải không?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "罗兰",
          "chinese": "是。",
          "pinyin": "Shì.",
          "vietnamese": "Phải.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "田芳",
          "chinese": "她也是留学生吗？",
          "pinyin": "Tā yě shì liúxuéshēng ma?",
          "vietnamese": "Cô ấy cũng là lưu học sinh phải không?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "罗兰",
          "chinese": "她也是留学生。我们都是留学生。",
          "pinyin": "Tā yě shì liúxuéshēng. Wǒmen dōu shì liúxuéshēng.",
          "vietnamese": "Cô ấy cũng là lưu học sinh. Chúng tôi đều là lưu học sinh.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "田芳",
          "chinese": "他们俩也都是留学生吗？",
          "pinyin": "Tāmen liǎ yě dōu shì liúxuéshēng ma?",
          "vietnamese": "Hai người họ cũng đều là lưu học sinh phải không?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "罗兰",
          "chinese": "不，他们俩不是留学生。他们都是中国学生。",
          "pinyin": "Bù, tāmen liǎ bú shì liúxuéshēng. Tāmen dōu shì Zhōngguó xuésheng.",
          "vietnamese": "Không, hai người họ không phải lưu học sinh. Họ đều là học sinh Trung Quốc.",
          "pinyinStatus": "existing_curated"
        }
      ],
      "sourceVerified": true
    },
    {
      "id": "b1_l11_d03",
      "title": "你也是中国人吗",
      "lines": [
        {
          "speaker": "爱德华",
          "chinese": "他是中国人吗？",
          "pinyin": "Tā shì Zhōngguó rén ma?",
          "vietnamese": "Anh ấy là người Trung Quốc phải không?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "李昌浩",
          "chinese": "是。",
          "pinyin": "Shì.",
          "vietnamese": "Phải.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "爱德华",
          "chinese": "你也是中国人吗？",
          "pinyin": "Nǐ yě shì Zhōngguó rén ma?",
          "vietnamese": "Bạn cũng là người Trung Quốc phải không?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "李昌浩",
          "chinese": "不是，我是韩国人。",
          "pinyin": "Bú shì, wǒ shì Hánguó rén.",
          "vietnamese": "Không, tôi là người Hàn Quốc.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "爱德华",
          "chinese": "对不起。",
          "pinyin": "Duìbuqǐ.",
          "vietnamese": "Xin lỗi.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "李昌浩",
          "chinese": "没什么。",
          "pinyin": "Méi shénme.",
          "vietnamese": "Không có gì.",
          "pinyinStatus": "existing_curated"
        }
      ],
      "sourceVerified": true
    }
  ],
