  "texts": [],
  "dialogues": [
    {
      "id": "b1_l12_d01",
      "title": "你在哪儿学习汉语",
      "lines": [
        {
          "speaker": "A",
          "chinese": "你在哪儿学习汉语？",
          "pinyin": "Nǐ zài nǎr xuéxí Hànyǔ?",
          "vietnamese": "Bạn học tiếng Hán ở đâu?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "B",
          "chinese": "在北京语言大学。",
          "pinyin": "Zài Běijīng Yǔyán Dàxué.",
          "vietnamese": "Ở Đại học Ngôn ngữ Bắc Kinh.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "A",
          "chinese": "你们的老师怎么样？",
          "pinyin": "Nǐmen de lǎoshī zěnmeyàng?",
          "vietnamese": "Giáo viên của các bạn thế nào?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "B",
          "chinese": "很好！",
          "pinyin": "Hěn hǎo!",
          "vietnamese": "Rất tốt!",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "A",
          "chinese": "你觉得学习汉语难吗？",
          "pinyin": "Nǐ juéde xuéxí Hànyǔ nán ma?",
          "vietnamese": "Bạn thấy học tiếng Hán có khó không?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "B",
          "chinese": "我觉得语法不太难。听和说也比较容易，但是读和写很难。",
          "pinyin": "Wǒ juéde yǔfǎ bú tài nán. Tīng hé shuō yě bǐjiào róngyì, dànshì dú hé xiě hěn nán.",
          "vietnamese": "Tôi thấy ngữ pháp không khó lắm. Nghe và nói cũng tương đối dễ, nhưng đọc và viết rất khó.",
          "pinyinStatus": "existing_curated"
        }
      ],
      "sourceVerified": true
    },
    {
      "id": "b1_l12_d02",
      "title": "你们的老师是谁",
      "lines": [
        {
          "speaker": "A",
          "chinese": "我给你们介绍一下儿，这位是新同学，是我的同屋。",
          "pinyin": "Wǒ gěi nǐmen jièshào yíxiàr, zhè wèi shì xīn tóngxué, shì wǒ de tóngwū.",
          "vietnamese": "Tôi giới thiệu với các bạn một chút, đây là bạn học mới, là bạn cùng phòng của tôi.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "B",
          "chinese": "你在哪个班学习？",
          "pinyin": "Nǐ zài nǎ ge bān xuéxí?",
          "vietnamese": "Bạn học ở lớp nào?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "C",
          "chinese": "在103班。",
          "pinyin": "Zài yī líng sān bān.",
          "vietnamese": "Ở lớp 103.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "B",
          "chinese": "你们的老师是谁？",
          "pinyin": "Nǐmen de lǎoshī shì shéi?",
          "vietnamese": "Giáo viên của các bạn là ai?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "C",
          "chinese": "我们的老师是林老师。",
          "pinyin": "Wǒmen de lǎoshī shì Lín lǎoshī.",
          "vietnamese": "Giáo viên của chúng tôi là thầy/cô Lâm.",
          "pinyinStatus": "existing_curated"
        }
      ],
      "sourceVerified": true
    }
  ],
  "grammar": [
    {
      "id": "b1_l12_g01",
      "pattern": "疑问代词 – Đại từ nghi vấn",
      "explanationVi": "Các đại từ như 谁、什么、哪、哪儿、怎么、怎么样、几、多少 dùng để hỏi và đứng ở vị trí của thành phần cần hỏi.",
      "sourceVerified": true
    },
    {
      "id": "b1_l12_g02",
      "pattern": "定语和结构助词“的”",
      "explanationVi": "Định ngữ đứng trước trung tâm ngữ; 的 thường nối định ngữ với trung tâm ngữ trong nhiều trường hợp.",
      "sourceVerified": true
    },
    {
      "id": "b1_l12_g03",
      "pattern": "介词“在”和“给”",
      "explanationVi": "在 + địa điểm có thể đứng trước động từ làm trạng ngữ; 给 có thể giới thiệu đối tượng hưởng lợi hoặc người nhận.",
      "sourceVerified": true
    }
  ],
  "usage": [],
  "phonetics": [
    {
      "id": "b1_l12_ph01",
      "pattern": "句重音（2）– Trọng âm câu",
      "explanationVi": "Định ngữ thường không nhấn bằng trung tâm ngữ; cụm giới từ làm định ngữ hoặc trạng ngữ có quy luật nhấn riêng.",
      "sourceVerified": true
    },
    {
      "id": "b1_l12_ph02",
      "pattern": "语调（2）– Ngữ điệu câu hỏi",
      "explanationVi": "Câu hỏi dùng đại từ nghi vấn thường không cần ngữ điệu lên như câu hỏi 吗; trọng âm rơi vào từ nghi vấn.",
      "sourceVerified": true
    }
  ],
