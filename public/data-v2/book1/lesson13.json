  "dialogues": [
    {
      "id": "b1_l13_d01",
      "title": "这个黑箱子很重",
      "lines": [
        {
          "speaker": "A",
          "chinese": "你没有箱子吗？",
          "pinyin": "Nǐ méiyǒu xiāngzi ma?",
          "vietnamese": "Bạn không có va-li/hòm à?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "B",
          "chinese": "有啊。我的在这儿呢。",
          "pinyin": "Yǒu a. Wǒ de zài zhèr ne.",
          "vietnamese": "Có chứ. Của tôi ở đây.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "A",
          "chinese": "我的很重，你的重不重？",
          "pinyin": "Wǒ de hěn zhòng, nǐ de zhòng bu zhòng?",
          "vietnamese": "Của tôi rất nặng, của bạn có nặng không?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "B",
          "chinese": "这个黑的很重，那个红的比较轻。",
          "pinyin": "Zhè ge hēi de hěn zhòng, nà ge hóng de bǐjiào qīng.",
          "vietnamese": "Cái màu đen này rất nặng, cái màu đỏ kia tương đối nhẹ.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "A",
          "chinese": "你的箱子很新，我的很旧。",
          "pinyin": "Nǐ de xiāngzi hěn xīn, wǒ de hěn jiù.",
          "vietnamese": "Va-li của bạn rất mới, của tôi rất cũ.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "B",
          "chinese": "那个新的是朋友的。这个旧的是我的。",
          "pinyin": "Nà ge xīn de shì péngyou de. Zhè ge jiù de shì wǒ de.",
          "vietnamese": "Cái mới kia là của bạn tôi. Cái cũ này là của tôi.",
          "pinyinStatus": "existing_curated"
        }
      ],
      "sourceVerified": true
    },
    {
      "id": "b1_l13_d02",
      "title": "这是不是中药",
      "lines": [
        {
          "speaker": "A",
          "chinese": "先生，这些黑的是什么东西？",
          "pinyin": "Xiānsheng, zhèxiē hēi de shì shénme dōngxi?",
          "vietnamese": "Thưa ông, những thứ màu đen này là gì?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "B",
          "chinese": "这是一些药。",
          "pinyin": "Zhè shì yìxiē yào.",
          "vietnamese": "Đây là một ít thuốc.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "A",
          "chinese": "什么药？",
          "pinyin": "Shénme yào?",
          "vietnamese": "Thuốc gì?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "B",
          "chinese": "中药。",
          "pinyin": "Zhōngyào.",
          "vietnamese": "Thuốc Đông y.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "A",
          "chinese": "这是不是药？",
          "pinyin": "Zhè shì bu shì yào?",
          "vietnamese": "Đây có phải là thuốc không?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "B",
          "chinese": "这不是药，这是茶叶。",
          "pinyin": "Zhè bú shì yào, zhè shì cháyè.",
          "vietnamese": "Đây không phải thuốc, đây là lá chè.",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "A",
          "chinese": "那个箱子里是什么？",
          "pinyin": "Nà ge xiāngzi lǐ shì shénme?",
          "vietnamese": "Trong cái hòm kia là gì?",
          "pinyinStatus": "existing_curated"
        },
        {
          "speaker": "B",
          "chinese": "都是日用品。有两件衣服、一把雨伞和一瓶香水，还有一本书、一本词典、两张光盘和三支笔。",
          "pinyin": "Dōu shì rìyòngpǐn. Yǒu liǎng jiàn yīfu, yì bǎ yǔsǎn hé yì píng xiāngshuǐ, hái yǒu yì běn shū, yì běn cídiǎn, liǎng zhāng guāngpán hé sān zhī bǐ.",
          "vietnamese": "Đều là đồ dùng hằng ngày. Có hai bộ quần áo, một cái ô và một chai nước hoa, còn có một quyển sách, một quyển từ điển, hai đĩa và ba cây bút.",
          "pinyinStatus": "existing_curated"
        }
      ],
      "sourceVerified": true
    }
  ],
  "grammar": [
    {
      "id": "b1_l13_g01",
      "pattern": "形容词谓语句 – Câu vị ngữ tính từ",
      "explanationVi": "Khi tính từ làm vị ngữ để miêu tả hoặc đánh giá, không dùng 是 giữa chủ ngữ và vị ngữ; thường có phó từ mức độ như 很.",
      "sourceVerified": true
    },
    {
      "id": "b1_l13_g02",
      "pattern": "正反问句（3）– Câu hỏi chính phản",
      "explanationVi": "Dùng dạng khẳng định + phủ định của thành phần chính để tạo câu hỏi, ví dụ 重不重、是不是.",
      "sourceVerified": true
    },
    {
