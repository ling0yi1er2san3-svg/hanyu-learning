  "dialogues": [
    {
      "id": "b2_l16_d01",
      "title": "你常去图书馆吗",
      "lines": [
        {
          "speaker": "玛丽",
          "chinese": "我现在去图书馆，你跟我一起去，好吗？",
          "pinyin": "Wǒ xiànzài qù túshūguǎn, nǐ gēn wǒ yìqǐ qù, hǎo ma?",
          "pinyinStatus": "existing_curated",
          "vietnamese": "Bây giờ tôi đi thư viện, bạn đi cùng tôi nhé?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "麦克",
          "chinese": "好，咱们走吧。……你常去图书馆吗？",
          "pinyin": "Hǎo, zánmen zǒu ba. Nǐ cháng qù túshūguǎn ma?",
          "pinyinStatus": "existing_curated",
          "vietnamese": "Được, chúng ta đi thôi. … Bạn có thường đến thư viện không?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "常去。我常借书，也常在那儿看书。你呢？常去吗？",
          "pinyin": "Cháng qù. Wǒ cháng jiè shū, yě cháng zài nàr kàn shū. Nǐ ne? Cháng qù ma?",
          "pinyinStatus": "existing_curated",
          "vietnamese": "Có. Tôi thường mượn sách, cũng thường đọc sách ở đó. Còn bạn? Bạn có thường đến không?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "麦克",
          "chinese": "我也常去。有时候借书，有时候上网查资料，但不常在那儿看书。那儿很安静。我总在宿舍看书。",
          "pinyin": "Wǒ yě cháng qù. Yǒushíhou jiè shū, yǒushíhou shàng wǎng chá zīliào, dàn bù cháng zài nàr kàn shū. Nàr hěn ānjìng. Wǒ zǒng zài sùshè kàn shū.",
          "pinyinStatus": "existing_curated",
          "vietnamese": "Tôi cũng thường đến. Có lúc mượn sách, có lúc lên mạng tra tài liệu, nhưng không thường đọc sách ở đó. Ở đó rất yên tĩnh. Tôi luôn đọc sách ở ký túc xá.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "你的宿舍安静吗？",
          "pinyin": "Nǐ de sùshè ānjìng ma?",
          "pinyinStatus": "existing_curated",
          "vietnamese": "Ký túc xá của bạn có yên tĩnh không?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "麦克",
          "chinese": "很安静。",
          "pinyin": "Hěn ānjìng.",
          "pinyinStatus": "existing_curated",
          "vietnamese": "Rất yên tĩnh.",
          "vietnameseStatus": "assistant_translation"
        }
      ],
      "sourceVerified": true
    },
    {
      "id": "b2_l16_d02",
      "title": "晚上你常做什么",
      "lines": [
        {
          "speaker": "A",
          "chinese": "晚上你常做什么？",
          "pinyin": "Wǎnshang nǐ cháng zuò shénme?",
          "pinyinStatus": "existing_curated",
          "vietnamese": "Buổi tối bạn thường làm gì?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "B",
          "chinese": "复习课文、预习生词，或者做练习。有时候上网跟朋友聊天儿，或者收发伊妹儿。",
          "pinyin": "fù xí kè wén, yù xí shēng cí， huò zhě zuò liàn xí. yǒu shí hòu shàng wǎng gēn péng yǒu liáo tiān ér， huò zhě shōu fā yī mèi ér.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Ôn bài khóa, chuẩn bị từ mới, hoặc làm bài tập. Có lúc lên mạng trò chuyện với bạn bè, hoặc gửi nhận email.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "A",
          "chinese": "我也常看中文电影和电视剧。你常看吗？",
          "pinyin": "wǒ yě cháng kàn zhōng wén diàn yǐng hé diàn shì jù. nǐ cháng kàn ma？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Tôi cũng thường xem phim và phim truyền hình Trung Quốc. Bạn có thường xem không?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "B",
          "chinese": "我很少看。",
          "pinyin": "wǒ hěn shǎo kàn.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Tôi rất ít xem.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "A",
          "chinese": "星期六和星期日你做什么？",
          "pinyin": "xīng qī liù hé xīng qī rì nǐ zuò shén me？",
          "pinyinStatus": "generated_icu_han_latin",
