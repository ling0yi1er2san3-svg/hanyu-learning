  "dialogues": [
    {
      "id": "b2_l17_d01",
      "title": "他在做什么呢",
      "lines": [
        {
          "speaker": "玛丽",
          "chinese": "麦克在宿舍吗？",
          "pinyin": "mài kè zài sù shě ma？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Mike có ở ký túc xá không?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "爱德华",
          "chinese": "在。",
          "pinyin": "zài.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Có.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "他在做什么呢？",
          "pinyin": "tā zài zuò shén me ne？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Anh ấy đang làm gì vậy?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "爱德华",
          "chinese": "我出来的时候，他正在听音乐呢。",
          "pinyin": "wǒ chū lái de shí hòu， tā zhèng zài tīng yīn lè ne.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Lúc tôi đi ra, anh ấy đang nghe nhạc.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "你是不是在听音乐呢？",
          "pinyin": "nǐ shìbù shìzài tīng yīn lè ne？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Bạn đang nghe nhạc phải không?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "麦克",
          "chinese": "没有，我正听课文录音呢。",
          "pinyin": "méi yǒu， wǒ zhèng tīng kè wén lù yīn ne.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Không, tôi đang nghe bản ghi âm bài khóa.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "下午你有事儿吗？",
          "pinyin": "xià wǔ nǐ yǒu shì ér ma？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Chiều nay bạn có việc gì không?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "麦克",
          "chinese": "没有事儿。",
          "pinyin": "méi yǒu shì ér.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Không có việc gì.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "我们一起去书店，好吗？",
          "pinyin": "wǒ men yī qǐ qù shū diàn， hǎo ma？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Chúng ta cùng đi nhà sách nhé?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "麦克",
          "chinese": "你要买什么书？",
          "pinyin": "nǐ yào mǎi shén me shū？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Bạn muốn mua sách gì?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "我想买一本《汉英词典》。",
          "pinyin": "wǒ xiǎng mǎi yī běn«hàn yīng cí diǎn».",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Tôi muốn mua một cuốn Từ điển Hán-Anh.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "麦克",
          "chinese": "咱们怎么去呢？",
          "pinyin": "zán men zěn me qù ne？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Chúng ta đi bằng cách nào?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "坐车去吧。",
          "pinyin": "zuò chē qù ba.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Đi xe nhé.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "麦克",
          "chinese": "今天星期六，坐车太挤，骑车去怎么样？",
          "pinyin": "jīn tiān xīng qī liù， zuò chē tài jǐ， qí chē qù zěn me yàng？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Hôm nay là thứ bảy, đi xe đông quá, đi xe đạp thì sao?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "行。",
          "pinyin": "xíng.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Được.",
          "vietnameseStatus": "assistant_translation"
        }
      ],
      "sourceVerified": true
    },
    {
      "id": "b2_l17_d02",
      "title": "谁教你们语法",
      "lines": [
        {
          "speaker": "田芳",
          "chinese": "玛丽，你们有几门课？",
          "pinyin": "mǎ lì， nǐ men yǒu jǐ mén kè？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Mary, các bạn có mấy môn học?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "现在只有四门课：综合课、口语课、听力课和阅读课。",
          "pinyin": "xiàn zài zhǐ yǒu sì mén kè： zōnghé kè, kǒu yǔ kè, tīng lì kè hé yuè dú kè.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Hiện giờ chỉ có bốn môn: tổng hợp, khẩu ngữ, nghe và đọc hiểu.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "田芳",
          "chinese": "有文化课和体育课吗？",
          "pinyin": "yǒu wén huà kè hé tǐ yù kè ma？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Có môn văn hóa và thể dục không?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "没有。",
          "pinyin": "méi yǒu.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Không có.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "田芳",
          "chinese": "林老师教你们什么？",
          "pinyin": "lín lǎo shī jiào nǐ men shén me？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Cô Lâm dạy các bạn môn gì?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "她教我们听力和阅读。",
          "pinyin": "tā jiào wǒ men tīng lì hé yuè dú.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Cô ấy dạy chúng tôi nghe và đọc hiểu.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "田芳",
          "chinese": "谁教你们综合课和口语课？",
          "pinyin": "shéi jiào nǐ men zōnghé kè hé kǒu yǔ kè？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Ai dạy các bạn môn tổng hợp và khẩu ngữ?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "王老师。",
          "pinyin": "wáng lǎo shī.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Thầy Vương.",
          "vietnameseStatus": "assistant_translation"
        }
      ],
      "sourceVerified": true
    }
  ],
  "grammar": [
    {
