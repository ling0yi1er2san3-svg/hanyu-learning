  "texts": [],
  "dialogues": [
    {
      "id": "b2_l18_d01",
      "title": "我去邮局寄包裹",
      "lines": [
        {
          "speaker": "田芳",
          "chinese": "张东，你要去哪儿？",
          "pinyin": "zhāng dōng， nǐ yào qù nǎ ér？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Zhang Dong, bạn định đi đâu?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "张东",
          "chinese": "我去邮局寄包裹，顺便去书店买一本书。你去吗？",
          "pinyin": "wǒ qù yóu jú jì bāo guǒ， shùn biàn qù shū diàn mǎi yī běnshū. nǐ qù ma？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Tôi đi bưu điện gửi bưu phẩm, tiện thể đi nhà sách mua một cuốn sách. Bạn có đi không?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "田芳",
          "chinese": "不去，一会儿玛丽来找我。你顺便替我买一张邮票和一份青年报吧。",
          "pinyin": "bù qù， yī huì ér mǎ lì lái zhǎowǒ. nǐ shùn biàn tìwǒ mǎi yī zhāng yóu piàohé yī fèn qīng nián bào ba.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Không đi, lát nữa Mary đến tìm tôi. Tiện thể bạn mua giúp tôi một con tem và một tờ Báo Thanh niên nhé.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "张东",
          "chinese": "好的。",
          "pinyin": "hǎo de.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Được.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "田芳",
          "chinese": "我给你拿钱。",
          "pinyin": "wǒ gěi nǐ náqián.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Tôi lấy tiền đưa bạn.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "张东",
          "chinese": "不用，先用我的钱买吧。",
          "pinyin": "bù yòng， xiān yòngwǒ de qián mǎi ba.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Không cần, cứ dùng tiền của tôi mua trước đi.",
          "vietnameseStatus": "assistant_translation"
        }
      ],
      "sourceVerified": true
    },
    {
      "id": "b2_l18_d02",
      "title": "外贸代表团明天去上海参观",
      "lines": [
        {
          "speaker": "珍妮",
          "chinese": "玛丽，我明天去上海。",
          "pinyin": "mǎ lì， wǒ míng tiān qù shàng hǎi.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Mary, ngày mai tôi đi Thượng Hải.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "你去上海旅行吗？",
          "pinyin": "nǐ qù shàng hǎi lǚ xíng ma？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Bạn đi Thượng Hải du lịch à?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "珍妮",
          "chinese": "不，明天一个外贸代表团去上海参观，我去给他们当翻译。",
          "pinyin": "bù， míng tiān yī gè wài mào dài biǎo tuán qù shàng hǎi cān guān， wǒ qù gěi tā men dāng fānyì.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Không, ngày mai có một đoàn đại biểu ngoại thương đi Thượng Hải tham quan, tôi đi làm phiên dịch cho họ.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "坐飞机去还是坐火车去？",
          "pinyin": "zuò fēi jīqù hái shìzuò huǒchē qù？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Đi máy bay hay đi tàu hỏa?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "珍妮",
          "chinese": "坐飞机去。",
          "pinyin": "zuò fēi jīqù.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Đi máy bay.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "什么时候回来？",
          "pinyin": "shén me shí hòu huí lái？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Khi nào về?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "珍妮",
          "chinese": "八号回来。替我办一件事，行吗？",
          "pinyin": "bā hào huí lái. tìwǒ bàn yī jiàn shì， xíng ma？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Ngày mùng 8 về. Bạn giúp tôi làm một việc được không?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "什么事？你说吧。",
          "pinyin": "shén me shì？ nǐ shuō ba.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Việc gì? Bạn nói đi.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "珍妮",
          "chinese": "帮我洗一下儿花。",
          "pinyin": "bāng wǒ xǐ yī xià ér huā.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Giúp tôi tưới hoa một chút nhé.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "行，没问题。",
          "pinyin": "xíng， méi wèn tí.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Được, không vấn đề gì.",
