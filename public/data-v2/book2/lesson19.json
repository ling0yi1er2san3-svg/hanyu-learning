  "dialogues": [
    {
      "id": "b2_l19_d01",
      "title": "可以试试吗",
      "lines": [
        {
          "speaker": "玛丽",
          "chinese": "我看看羽绒服。",
          "pinyin": "wǒ kàn kàn yǔróng fú.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Tôi xem áo lông vũ một chút.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "售货员",
          "chinese": "你看看这件，怎么样？又好又便宜。",
          "pinyin": "nǐ kàn kàn zhè jiàn， zěn me yàng？ yòu hǎo yòu biàn yí.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Bạn xem chiếc này đi, thế nào? Vừa đẹp vừa rẻ.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "这件有一点儿长。有短一点儿的吗？",
          "pinyin": "zhè jiàn yǒu yī diǎnér zhǎng. yǒu duǎnyī diǎnér de ma？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Chiếc này hơi dài. Có chiếc nào ngắn hơn một chút không?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "售货员",
          "chinese": "你要深颜色的还是要浅颜色的？",
          "pinyin": "nǐ yào shēn yán sè de hái shìyào qiǎn yán sè de？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Bạn muốn màu đậm hay màu nhạt?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "浅颜色的。……我试试，可以吗？",
          "pinyin": "qiǎn yán sè de.……wǒ shì shì， kě yǐ ma？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Màu nhạt. … Tôi thử nhé, được không?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "售货员",
          "chinese": "当然可以。",
          "pinyin": "dāng rán kě yǐ.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Tất nhiên là được.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "这件太肥了，有没有瘦一点儿的？",
          "pinyin": "zhè jiàn tài féi le， yǒu méi yǒu shòu yī diǎnér de？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Chiếc này rộng quá, có chiếc nào ôm hơn một chút không?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "售货员",
          "chinese": "你再试试这一件。",
          "pinyin": "nǐ zài shì shì zhè yī jiàn.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Bạn thử lại chiếc này xem.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "这件不大不小，正合适，颜色也很好看。",
          "pinyin": "zhè jiàn bù dà bù xiǎo， zhèng hé shì， yán sè yě hěn hǎo kàn.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Chiếc này không to không nhỏ, vừa vặn, màu sắc cũng rất đẹp.",
          "vietnameseStatus": "assistant_translation"
        }
      ],
      "sourceVerified": true
    },
    {
      "id": "b2_l19_d02",
      "title": "便宜一点儿吧",
      "lines": [
        {
          "speaker": "玛丽",
          "chinese": "这种羽绒服怎么卖？",
          "pinyin": "zhè zhǒng yǔróng fú zěn me mài？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Loại áo lông vũ này bán thế nào?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "售货员",
          "chinese": "一件四百块。",
          "pinyin": "yī jiàn sì bǎikuài.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Một chiếc 400 tệ.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "太贵了。便宜一点儿吧，二百怎么样？",
          "pinyin": "tài guì le. biàn yí yī diǎnér ba， èr bǎizěn me yàng？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Đắt quá. Rẻ hơn một chút nhé, 200 thì sao?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "售货员",
          "chinese": "二百太少了，不卖。可以打八折，你给三百二吧。",
          "pinyin": "èr bǎitài shǎo le， bù mài. kě yǐ dǎ bā zhé， nǐ gěi sān bǎièr ba.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "200 thì ít quá, không bán. Có thể giảm 20%, bạn trả 320 đi.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "三百行不行？",
          "pinyin": "sān bǎixíng bù xíng？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "300 được không?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "售货员",
          "chinese": "好吧。",
          "pinyin": "hǎo ba.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Được thôi.",
          "vietnameseStatus": "assistant_translation"
        }
      ],
      "sourceVerified": true
    }
