  "dialogues": [
    {
      "id": "b2_l20_d01",
      "title": "你哪一年大学毕业",
      "lines": [
        {
          "speaker": "A",
          "chinese": "你哪一年大学毕业？",
          "pinyin": "nǐ nǎ yī nián dà xué bì yè？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Bạn tốt nghiệp đại học năm nào?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "B",
          "chinese": "明年。你呢？",
          "pinyin": "míng nián. nǐ ne？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Năm sau. Còn bạn?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "A",
          "chinese": "我后年。你今年多大？",
          "pinyin": "wǒ hòu nián. nǐ jīn nián duō dà？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Tôi năm kia sau nữa. Năm nay bạn bao nhiêu tuổi?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "B",
          "chinese": "我二十一岁。",
          "pinyin": "wǒ èr shí yī suì.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Tôi 21 tuổi.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "A",
          "chinese": "属什么的？",
          "pinyin": "shǔ shén me de？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Bạn tuổi con gì?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "B",
          "chinese": "属狗的。",
          "pinyin": "shǔ gǒu de.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Tôi tuổi chó.",
          "vietnameseStatus": "assistant_translation"
        }
      ],
      "sourceVerified": true
    },
    {
      "id": "b2_l20_d02",
      "title": "祝你生日快乐",
      "lines": [
        {
          "speaker": "A",
          "chinese": "你的生日是几月几号？",
          "pinyin": "nǐ de shēng rì shìjǐ yuè jǐ hào？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Sinh nhật của bạn là ngày mấy tháng mấy?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "B",
          "chinese": "我的生日是十月十八号，正好是星期六。",
          "pinyin": "wǒ de shēng rì shìshí yuè shí bā hào， zhèng hǎo shìxīng qī liù.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Sinh nhật tôi là ngày 18 tháng 10, đúng vào thứ bảy.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "A",
          "chinese": "是吗？你打算怎么过？",
          "pinyin": "shìma？ nǐ dǎ suàn zěn me guò？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Thật à? Bạn định tổ chức thế nào?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "B",
          "chinese": "我准备举行一个生日晚会。你也来参加，好吗？",
          "pinyin": "wǒ zhǔn bèi jǔ xíng yī gè shēng rì wǎn huì. nǐ yě lái cān jiā， hǎo ma？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Tôi chuẩn bị tổ chức một buổi tiệc sinh nhật. Bạn cũng đến tham gia nhé?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "A",
          "chinese": "什么时候举行？",
          "pinyin": "shén me shí hòu jǔ xíng？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Khi nào tổ chức?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "B",
          "chinese": "星期六晚上七点。",
          "pinyin": "xīng qī liù wǎn shàng qī diǎn.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Bảy giờ tối thứ bảy.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "A",
          "chinese": "在哪儿？",
          "pinyin": "zài nǎ ér？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Ở đâu?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "B",
          "chinese": "就在我的房间。",
          "pinyin": "jiù zài wǒ de fángjiān.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Ngay trong phòng của tôi.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "A",
          "chinese": "好。我一定去。祝你生日快乐！",
          "pinyin": "hǎo. wǒ yī dìng qù. zhù nǐ shēng rì kuài lè！",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Được. Tôi nhất định sẽ đến. Chúc bạn sinh nhật vui vẻ!",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "B",
          "chinese": "谢谢！",
          "pinyin": "xiè xiè！",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Cảm ơn!",
          "vietnameseStatus": "assistant_translation"
        }
      ],
      "sourceVerified": true
    }
  ],
