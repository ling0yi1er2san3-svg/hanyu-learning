  "texts": [
    {
      "id": "b2_l21_t01",
      "title": "我的一天",
      "chinese": "我每天早上六点半起床，七点吃早饭。差十分八点去教室，八点上课。上午我们有四节课，十一点下课。中午我去食堂吃午饭。午饭以后，我常常去朋友那儿聊天儿。下午没有课的时候，我去图书馆看书，或者上网查资料。晚上我做练习、写汉字、预习课文和生词，然后看看电视、听听音乐，十一点睡觉。",
      "sourceVerified": true,
      "pinyin": "wǒ měi tiān zǎoshàng liù diǎnbàn qǐ chuáng， qī diǎnchī zǎofàn. chà shí fēn bā diǎnqù jiào shì， bā diǎnshàng kè. shàng wǔ wǒ men yǒu sì jié kè， shí yī diǎnxià kè. zhōng wǔ wǒ qù shí táng chī wǔ fàn. wǔ fàn yǐ hòu， wǒ cháng cháng qù péng yǒu nà ér liáo tiān ér. xià wǔ méi yǒu kè de shí hòu， wǒ qù tú shū guǎn kàn shū， huò zhě shàng wǎng chá zī liào. wǎn shàng wǒ zuò liàn xí, xiě hàn zì, yù xí kè wén hé shēng cí， rán hòu kàn kàn diàn shì, tīng tīng yīn lè， shí yī diǎnshuì jué.",
      "pinyinStatus": "generated_icu_han_latin",
      "vietnamese": "Mỗi ngày tôi dậy lúc 6 giờ 30 sáng, 7 giờ ăn sáng. 7 giờ 50 tôi đến lớp, 8 giờ bắt đầu học. Buổi sáng chúng tôi có bốn tiết, 11 giờ tan học. Buổi trưa tôi đến nhà ăn dùng bữa. Sau bữa trưa, tôi thường đến chỗ bạn bè trò chuyện. Buổi chiều khi không có tiết, tôi đến thư viện đọc sách hoặc lên mạng tra tài liệu. Buổi tối tôi làm bài tập, viết chữ Hán, chuẩn bị bài khóa và từ mới, sau đó xem tivi, nghe nhạc một chút, 11 giờ đi ngủ.",
      "vietnameseStatus": "assistant_translation"
    }
  ],
  "dialogues": [
    {
      "id": "b2_l21_d01",
      "title": "明天早上七点一刻出发",
      "lines": [
        {
          "speaker": "老师",
          "chinese": "同学们，明天我们去爬山。",
          "pinyin": "tóng xué men， míng tiān wǒ men qù páshān.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Các em, ngày mai chúng ta đi leo núi.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "山本",
          "chinese": "太好了！老师，您去吗？",
          "pinyin": "tài hǎo le！ lǎo shī， nínqù ma？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Tuyệt quá! Thưa thầy/cô, thầy/cô có đi không?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "老师",
          "chinese": "去。一年级的老师和学生都去。",
          "pinyin": "qù. yī nián jí de lǎo shī hé xué shēng dōu qù.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Có. Giáo viên và học sinh năm nhất đều đi.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "山本",
          "chinese": "明天什么时候出发？",
          "pinyin": "míng tiān shén me shí hòu chū fā？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Ngày mai mấy giờ xuất phát?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "老师",
          "chinese": "明天早上七点在楼前集合上车，七点一刻准时出发。",
          "pinyin": "míng tiān zǎoshàng qī diǎnzài lóuqián jí hé shàng chē， qī diǎnyī kè zhǔn shí chū fā.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Sáng mai 7 giờ tập trung trước tòa nhà để lên xe, 7 giờ 15 xuất phát đúng giờ.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "山本",
          "chinese": "中午回来吗？",
          "pinyin": "zhōng wǔ huí lái ma？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Buổi trưa có về không?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "老师",
          "chinese": "不回来，要带午饭。",
          "pinyin": "bù huí lái， yào dài wǔ fàn.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Không về, phải mang theo bữa trưa.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "山本",
          "chinese": "什么时候回来？",
          "pinyin": "shén me shí hòu huí lái？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Khi nào về?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "老师",
          "chinese": "下午四点。",
          "pinyin": "xià wǔ sì diǎn.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "4 giờ chiều.",
          "vietnameseStatus": "assistant_translation"
        }
      ],
      "sourceVerified": true
    }
  ],
