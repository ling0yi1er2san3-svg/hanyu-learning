  "texts": [],
  "dialogues": [
    {
      "id": "b2_l22_d01",
      "title": "我打算请老师教我京剧",
      "lines": [
        {
          "speaker": "老师",
          "chinese": "今天想请大家谈谈自己的爱好。谁先说？",
          "pinyin": "jīn tiān xiǎng qǐng dà jiā tán tán zì jǐ de ài hǎo. shéi xiān shuō？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Hôm nay tôi muốn mời mọi người nói về sở thích của mình. Ai nói trước?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "老师，让我先说吧。",
          "pinyin": "lǎo shī， ràng wǒ xiān shuō ba.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Thưa thầy/cô, để em nói trước nhé.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "老师",
          "chinese": "好，你说吧。你有什么爱好？",
          "pinyin": "hǎo， nǐ shuō ba. nǐ yǒu shén me ài hǎo？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Được, em nói đi. Em có sở thích gì?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "我的爱好是看京剧。",
          "pinyin": "wǒ de ài hǎo shìkàn jīng jù.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Sở thích của em là xem Kinh kịch.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "老师",
          "chinese": "你喜欢看京剧？",
          "pinyin": "nǐ xǐ huān kàn jīng jù？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Em thích xem Kinh kịch à?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "是啊，非常喜欢。我还想学唱京剧，打算请一个老师教我。",
          "pinyin": "shìa， fēi cháng xǐ huān. wǒ hái xiǎng xué chàng jīng jù， dǎ suàn qǐng yī gè lǎo shī jiào wǒ.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Vâng, em rất thích. Em còn muốn học hát Kinh kịch, định mời một giáo viên dạy em.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "老师",
          "chinese": "麦克，你喜欢做什么？",
          "pinyin": "mài kè， nǐ xǐ huān zuò shén me？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Mike, em thích làm gì?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "麦克",
          "chinese": "我喜欢玩电脑。",
          "pinyin": "wǒ xǐ huān wándiàn nǎo.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Em thích chơi máy tính.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "罗兰",
          "chinese": "我喜欢听音乐，下课以后，听听音乐或者跟朋友聊聊天儿，感到心情很愉快。",
          "pinyin": "wǒ xǐ huān tīng yīn lè， xià kè yǐ hòu， tīng tīng yīn lè huò zhě gēn péng yǒu liáo liáo tiān ér， gǎn dào xīn qíng hěn yú kuài.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Tôi thích nghe nhạc. Sau giờ học, nghe nhạc một chút hoặc trò chuyện với bạn bè khiến tôi cảm thấy rất vui vẻ.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "田中",
          "chinese": "我来中国以前就对书法特别感兴趣。今年公司派我来中国，我非常高兴。现在我正在跟一个老师学书法，还学画中国画儿。",
          "pinyin": "wǒ lái zhōng guó yǐ qián jiù duì shū fǎ tèbié gǎn xìng qù. jīn nián gōng sī pàiwǒ lái zhōng guó， wǒ fēi cháng gāo xìng. xiàn zài wǒ zhèng zài gēn yī gè lǎo shī xué shū fǎ， hái xué huàzhōng guó huàér.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Trước khi đến Trung Quốc tôi đã đặc biệt hứng thú với thư pháp. Năm nay công ty cử tôi sang Trung Quốc, tôi rất vui. Hiện giờ tôi đang học thư pháp với một giáo viên, còn học vẽ tranh Trung Quốc nữa.",
          "vietnameseStatus": "assistant_translation"
        }
      ],
      "sourceVerified": true
    }
  ],
  "grammar": [
    {
      "id": "b2_l22_g01",
      "pattern": "兼语句 – Câu kiêm ngữ",
      "explanationVi": "“请、叫、让”等使令动词可形成兼语句：前一动词的宾语同时是后一动词的主语。",
      "sourceVerified": true
    }
  ],
  "usage": [
