    },
    {
      "id": "b2_l22_u03",
      "pattern": "啊的音变",
      "explanationVi": "“啊”的读音受前一音节末音影响，书写时可变为“呀、哇、哪”等。",
      "sourceVerified": true
    }
  ],
  "phonetics": [
    {
