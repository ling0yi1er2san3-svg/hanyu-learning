  "dialogues": [
    {
      "id": "b2_l23_d01",
      "title": "学校里边有邮局吗",
      "lines": [
        {
          "speaker": "山本",
          "chinese": "学校里边有邮局吗？",
          "pinyin": "xué xiào lǐ biān yǒu yóu jú ma？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Trong trường có bưu điện không?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "张东",
          "chinese": "有。",
          "pinyin": "yǒu.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Có.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "山本",
          "chinese": "邮局在哪儿？",
          "pinyin": "yóu jú zài nǎ ér？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Bưu điện ở đâu?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "张东",
          "chinese": "在图书馆西边。",
          "pinyin": "zài tú shū guǎn xī biān.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Ở phía tây thư viện.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "山本",
          "chinese": "离这儿远吗？",
          "pinyin": "lízhè ér yuǎn ma？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Cách đây có xa không?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "张东",
          "chinese": "不远，很近。",
          "pinyin": "bù yuǎn， hěn jìn.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Không xa, rất gần.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "山本",
          "chinese": "图书馆东边是什么地方？",
          "pinyin": "tú shū guǎn dōng biān shìshén me de fāng？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Phía đông thư viện là nơi nào?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "张东",
          "chinese": "图书馆东边是一个足球场。",
          "pinyin": "tú shū guǎn dōng biān shìyī gè zú qiú chǎng.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Phía đông thư viện là một sân bóng đá.",
          "vietnameseStatus": "assistant_translation"
        }
      ],
      "sourceVerified": true
    },
    {
      "id": "b2_l23_d02",
      "title": "从这儿到博物馆有多远",
      "lines": [
        {
          "speaker": "玛丽",
          "chinese": "劳驾，我打听一下儿，博物馆在哪儿？",
          "pinyin": "láo jià， wǒ dǎ tīng yī xià ér， bó wùguǎn zài nǎ ér？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Xin lỗi, cho tôi hỏi một chút, bảo tàng ở đâu?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "路人",
          "chinese": "博物馆在东边，在和平公园和人民广场中间。",
          "pinyin": "bó wùguǎn zài dōng biān， zài hé píng gōng yuán hé rén mín guǎng chǎng zhōng jiān.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Bảo tàng ở phía đông, nằm giữa Công viên Hòa Bình và Quảng trường Nhân Dân.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "离这儿有多远？",
          "pinyin": "lízhè ér yǒu duō yuǎn？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Cách đây bao xa?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "路人",
          "chinese": "从这儿到那儿大概有七八百米。",
          "pinyin": "cóng zhè ér dào nà ér dà gài yǒu qī bā bǎimǐ.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Từ đây đến đó khoảng 700–800 mét.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "怎么走呢？",
          "pinyin": "zěn me zǒu ne？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Đi thế nào?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "路人",
          "chinese": "你从这儿一直往东走，到红绿灯那儿往右拐，马路左边有一座白色的大楼，那就是博物馆。",
          "pinyin": "nǐ cóng zhè ér yī zhí wǎng dōng zǒu， dào hóng lǜdēngnà ér wǎng yòu guǎi， mǎ lù zuǒ biān yǒu yī zuò báisè de dà lóu， nà jiù shìbó wùguǎn.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Bạn cứ từ đây đi thẳng về phía đông, đến chỗ đèn giao thông thì rẽ phải. Bên trái đường có một tòa nhà lớn màu trắng, đó chính là bảo tàng.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "谢谢您！",
          "pinyin": "xiè xiè nín！",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Cảm ơn bác/anh/chị!",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "路人",
          "chinese": "不客气。",
          "pinyin": "bù kè qì.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Không có gì.",
          "vietnameseStatus": "assistant_translation"
        }
      ],
      "sourceVerified": true
    }
  ],
  "grammar": [
    {
      "id": "b2_l23_g01",
      "pattern": "方位词 – Phương vị từ",
      "explanationVi": "东、西、南、北、前、后、左、右、上、下、里、外等表示方向或位置；作定语时常加“的”。",
      "sourceVerified": true
    },
    {
      "id": "b2_l23_g02",
      "pattern": "在 / 有 / 是",
      "explanationVi": "“名词 + 在 + 方位词”表示位置；“方位词 + 有 + 名词”表示存在；已知存在而询问是什么时可用“方位词 + 是 + 名词”。",
      "sourceVerified": true
    },
    {
      "id": "b2_l23_g03",
      "pattern": "离 / 从 / 往",
      "explanationVi": "离表示距离；从表示起点；往表示动作方向，均可与处所词连用。",
      "sourceVerified": true
    }
  ],
  "usage": [
    {
      "id": "b2_l23_u01",
      "pattern": "有多远 / 多高 / 多大……",
      "explanationVi": "“多 + 形容词”用于询问距离、高度、年龄、重量、长度等。",
      "sourceVerified": true
    },
    {
      "id": "b2_l23_u02",
      "pattern": "两数相邻表示约数",
      "explanationVi": "相邻两个数字连用可表示约数，如“七八百米”。",
      "sourceVerified": true
    }
  ],
  "phonetics": [
    {
      "id": "b2_l23_p01",
      "pattern": "“有 / 是”在存在句中的重音",
      "explanationVi": "存在句中的“有、是”通常不重读。",
      "sourceVerified": true
    }
  ],
