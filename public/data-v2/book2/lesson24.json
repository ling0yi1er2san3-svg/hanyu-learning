  "dialogues": [
    {
      "id": "b2_l24_d01",
      "title": "我想学太极拳",
      "lines": [
        {
          "speaker": "玛丽",
          "chinese": "你会打太极拳吗？",
          "pinyin": "nǐ huì dǎ tài jí quán ma？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Bạn biết đánh Thái Cực Quyền không?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "罗兰",
          "chinese": "不会。你呢？",
          "pinyin": "bù huì. nǐ ne？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Không biết. Còn bạn?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "我也不会。你想不想学？",
          "pinyin": "wǒ yě bù huì. nǐ xiǎng bù xiǎng xué？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Tôi cũng không biết. Bạn có muốn học không?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "罗兰",
          "chinese": "想学。",
          "pinyin": "xiǎng xué.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Muốn học.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "我也想学。听说体育老师下星期教太极拳，我们去报名吧。",
          "pinyin": "wǒ yě xiǎng xué. tīng shuō tǐ yù lǎo shī xià xīng qī jiào tài jí quán， wǒ men qù bào míng ba.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Tôi cũng muốn học. Nghe nói tuần sau giáo viên thể dục dạy Thái Cực Quyền, chúng ta đi đăng ký nhé.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "罗兰",
          "chinese": "好。",
          "pinyin": "hǎo.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Được.",
          "vietnameseStatus": "assistant_translation"
        }
      ],
      "sourceVerified": true
    },
    {
      "id": "b2_l24_d02",
      "title": "您能不能再说一遍",
      "lines": [
        {
          "speaker": "玛丽",
          "chinese": "老师，我们想学太极拳，现在可以报名吗？",
          "pinyin": "lǎo shī， wǒ men xiǎng xué tài jí quán， xiàn zài kě yǐ bào míng ma？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Thưa thầy/cô, chúng em muốn học Thái Cực Quyền, bây giờ có thể đăng ký không?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "老师",
          "chinese": "可以。",
          "pinyin": "kě yǐ.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Có thể.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "什么时候开始上课？",
          "pinyin": "shén me shí hòu kāi shǐ shàng kè？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Khi nào bắt đầu học?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "老师",
          "chinese": "下星期一。",
          "pinyin": "xià xīng qī yī.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Thứ hai tuần sau.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "每天下午都有课吗？",
          "pinyin": "měi tiān xià wǔ dōu yǒu kè ma？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Chiều nào cũng có lớp à?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "老师",
          "chinese": "不，只一三五下午。",
          "pinyin": "bù， zhǐ yī sān wǔ xià wǔ.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Không, chỉ học vào chiều thứ hai, thứ tư và thứ sáu.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "对不起，您能不能再说一遍？我不懂“一三五”是什么意思。",
          "pinyin": "duì bù qǐ， nínnéng bù néng zài shuō yī biàn？ wǒ bù dǒng “yī sān wǔ” shìshén me yì sī.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Xin lỗi, thầy/cô có thể nói lại một lần nữa không? Em không hiểu “một-ba-năm” nghĩa là gì.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "老师",
          "chinese": "就是星期一、星期三、星期五。",
          "pinyin": "jiù shìxīng qī yī, xīng qī sān, xīng qī wǔ.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Tức là thứ hai, thứ tư và thứ sáu.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "从几点到几点上课？",
          "pinyin": "cóng jǐ diǎndào jǐ diǎnshàng kè？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Học từ mấy giờ đến mấy giờ?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "老师",
          "chinese": "四点半到五点半，一次一个小时。",
          "pinyin": "sì diǎnbàn dào wǔ diǎnbàn， yī cì yī gè xiǎo shí.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Từ 4 giờ 30 đến 5 giờ 30, mỗi buổi một tiếng.",
          "vietnameseStatus": "assistant_translation"
        }
      ],
      "sourceVerified": true
    },
    {
      "id": "b2_l24_d03",
      "title": "请假",
      "lines": [
        {
          "speaker": "老师",
          "chinese": "玛丽……玛丽怎么没来？",
          "pinyin": "mǎ lì……mǎ lì zěn me méi lái？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Mary… sao Mary chưa đến?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "罗兰",
          "chinese": "老师，玛丽让我替她请一个假。她今天有点儿不舒服，头疼，发烧，咳嗽，可能感冒了。她要去医院看病，不能来上课。",
          "pinyin": "lǎo shī， mǎ lì ràng wǒ tìtā qǐng yī gè jiǎ. tā jīn tiān yǒu diǎnér bù shū fú， tóu téng， fā shāo， hāi sòu， kě néng gǎn mào le. tā yào qù yī yuàn kàn bìng， bù néng lái shàng kè.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Thưa thầy/cô, Mary nhờ em xin nghỉ giúp bạn ấy một buổi. Hôm nay bạn ấy hơi khó chịu, đau đầu, sốt, ho, có lẽ bị cảm. Bạn ấy phải đến bệnh viện khám nên không thể đến lớp.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "老师",
          "chinese": "她有病了。",
          "pinyin": "tā yǒu bìng le.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Bạn ấy bị ốm rồi.",
          "vietnameseStatus": "assistant_translation"
        }
      ],
      "sourceVerified": true
    }
  ],
  "grammar": [
    {
      "id": "b2_l24_g01",
      "pattern": "能愿动词 – Động từ năng nguyện",
      "explanationVi": "会、想、要、能、可以等放在主要动词前表示能力、愿望、要求或可能。否定时“不”放在能愿动词前。",
      "sourceVerified": true
    },
    {
      "id": "b2_l24_g02",
