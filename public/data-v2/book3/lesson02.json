  "dialogues": [
    {
      "id": "b3_l02_d01",
      "title": "我们那儿的冬天跟北京一样冷",
      "lines": [
        {
          "speaker": "田芳",
          "chinese": "罗兰，你们国家的气温跟北京不一样吧？",
          "pinyin": "luó lán， nǐ men guó jiā de qì wēngēn běi jīng bù yī yàng ba？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Roland, nhiệt độ ở nước bạn khác Bắc Kinh phải không?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "罗兰",
          "chinese": "当然不一样。我们那儿跟北京有七个小时的时差呢。",
          "pinyin": "dāng rán bù yī yàng. wǒ men nà ér gēn běi jīng yǒu qī gè xiǎo shí de shí chà ne.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Tất nhiên là khác. Chỗ chúng tôi lệch Bắc Kinh tới bảy tiếng.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "田芳",
          "chinese": "你们那儿早还是北京早？",
          "pinyin": "nǐ men nà ér zǎohái shìběi jīng zǎo？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Chỗ bạn sớm hơn hay Bắc Kinh sớm hơn?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "罗兰",
          "chinese": "北京比我们那儿早七个小时。现在北京是上午八点多，我们那儿才夜里一点多。",
          "pinyin": "běi jīng bǐ wǒ men nà ér zǎoqī gè xiǎo shí. xiàn zài běi jīng shìshàng wǔ bā diǎnduō， wǒ men nà ér cái yè lǐ yī diǎnduō.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Bắc Kinh sớm hơn chỗ chúng tôi bảy tiếng. Bây giờ Bắc Kinh hơn tám giờ sáng, còn chỗ chúng tôi mới hơn một giờ đêm.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "田芳",
          "chinese": "季节跟北京一样吗？",
          "pinyin": "jì jié gēn běi jīng yī yàng ma？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Các mùa có giống Bắc Kinh không?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "罗兰",
          "chinese": "季节跟北京一样，也是春、夏、秋、冬四个季节。",
          "pinyin": "jì jié gēn běi jīng yī yàng， yě shìchūn, xià, qiū, dōng sì gè jì jié.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Các mùa giống Bắc Kinh, cũng có bốn mùa xuân, hạ, thu, đông.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "田芳",
          "chinese": "气候跟北京一样不一样？",
          "pinyin": "qì hòu gēn běi jīng yī yàng bù yī yàng？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Khí hậu có giống Bắc Kinh không?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "罗兰",
          "chinese": "不一样。北京的夏天很热，我们那儿夏天没有这么热。",
          "pinyin": "bù yī yàng. běi jīng de xià tiān hěn rè， wǒ men nà ér xià tiān méi yǒu zhè me rè.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Không giống. Mùa hè Bắc Kinh rất nóng, chỗ chúng tôi mùa hè không nóng như vậy.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "田芳",
          "chinese": "冬天冷不冷？",
          "pinyin": "dōng tiān lěng bù lěng？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Mùa đông có lạnh không?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "罗兰",
          "chinese": "冬天跟北京一样冷，但是不常刮大风。",
          "pinyin": "dōng tiān gēn běi jīng yī yàng lěng， dàn shìbù cháng guā dà fēng.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Mùa đông lạnh như Bắc Kinh, nhưng không thường có gió lớn.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "田芳",
          "chinese": "常下雪吗？",
          "pinyin": "cháng xià xuě ma？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Có thường xuyên có tuyết không?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "罗兰",
          "chinese": "不但常常下雪，而且下得很大。北京呢？",
          "pinyin": "bù dàn cháng cháng xià xuě， ér qiě xià dé hěn dà. běi jīng ne？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Không những thường xuyên có tuyết mà còn rơi rất dày. Còn Bắc Kinh thì sao?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "田芳",
          "chinese": "北京冬天不常下雪。",
          "pinyin": "běi jīng dōng tiān bù cháng xià xuě.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Mùa đông ở Bắc Kinh không thường có tuyết.",
          "vietnameseStatus": "assistant_translation"
        }
      ],
      "sourceVerified": true
    },
    {
      "id": "b3_l02_d02",
      "title": "我跟你不一样",
      "lines": [
        {
          "speaker": "麦克",
          "chinese": "这次你考得怎么样？",
          "pinyin": "zhè cì nǐ kǎo dé zěn me yàng？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Lần này bạn thi thế nào?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "还可以，综合课考了95分，听力跟阅读一样，都是90分，口语考得不太好，只考了85分。你呢？",
