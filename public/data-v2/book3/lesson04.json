  "dialogues": [
    {
      "id": "b3_l04_d01",
      "title": "我给你捎来了一些东西",
      "lines": [
        {
          "speaker": "林老师",
          "chinese": "王老师吗？我是小林。",
          "pinyin": "wáng lǎo shī ma？ wǒ shìxiǎo lín.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Có phải thầy Vương không? Em là Tiểu Lâm đây.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "王老师",
          "chinese": "啊，小林。你不是到台湾开汉语教学研讨会去了吗？",
          "pinyin": "a， xiǎo lín. nǐ bù shìdào tái wānkāi hàn yǔ jiào xué yán tǎo huì qù le ma？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "À, Tiểu Lâm. Chẳng phải em đi Đài Loan dự hội thảo giảng dạy tiếng Hán sao?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "林老师",
          "chinese": "我开完会回来了。昨天晚上刚到家。我回来的时候，经过香港，到小魏家去看了看。",
          "pinyin": "wǒ kāi wán huì huí lái le. zuótiān wǎn shàng gāng dào jiā. wǒ huí lái de shí hòu， jīng guò xiāng gǎng， dào xiǎo wèi jiā qù kàn le kàn.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Em họp xong về rồi. Tối qua vừa mới về đến nhà. Lúc về em đi qua Hồng Kông, có ghé nhà Tiểu Ngụy thăm một chút.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "王老师",
          "chinese": "是吗？小魏好吗？",
          "pinyin": "shìma？ xiǎo wèi hǎo ma？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Thế à? Tiểu Ngụy có khỏe không?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "林老师",
          "chinese": "挺好的。她让我向您问好，还让我给您捎来一些东西。我想给您送去。",
          "pinyin": "tǐnghǎo de. tā ràng wǒ xiàng nínwèn hǎo， hái ràng wǒ gěi nínshāo lái yī xiē dōng xī. wǒ xiǎng gěi nínsòng qù.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Rất khỏe. Cô ấy nhờ em gửi lời hỏi thăm thầy, còn nhờ em mang cho thầy ít đồ. Em định mang sang cho thầy.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "王老师",
          "chinese": "我过去取吧。",
          "pinyin": "wǒ guò qù qǔ ba.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Để tôi qua lấy vậy.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "林老师",
          "chinese": "不用。我正好要下楼去，顺便就给您带去了。",
          "pinyin": "bù yòng. wǒ zhèng hǎo yào xià lóuqù， shùn biàn jiù gěi níndài qù le.",
          "pinyinStatus": "generated_icu_han_latin",
