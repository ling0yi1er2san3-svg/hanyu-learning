  "dialogues": [
    {
      "id": "b3_l05_d01",
      "title": "我吃过中药",
      "lines": [
        {
          "speaker": "爱德华",
          "chinese": "山本，你的感冒好了吗？",
          "pinyin": "shān běn， nǐ de gǎn mào hǎo le ma？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Edward, cảm của bạn khỏi chưa?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "山本",
          "chinese": "好多了。来中国以后我已经得过三次感冒了。",
          "pinyin": "hǎo duō le. lái zhōng guó yǐ hòu wǒ yǐ jīng dé guò sān cì gǎn mào le.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Đỡ nhiều rồi. Từ khi đến Trung Quốc tôi đã bị cảm ba lần rồi.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "爱德华",
          "chinese": "我一次病也没有得过。",
          "pinyin": "wǒ yī cì bìng yě méi yǒu dé guò.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Tôi thì chưa từng bị bệnh lần nào.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "山本",
          "chinese": "你身体真不错。我还住过一次院呢，看过中医，也吃过中药。",
          "pinyin": "nǐ shēn tǐ zhēn bù cuò. wǒ hái zhù guò yī cì yuàn ne， kàn guò zhōng yī， yě chī guò zhōng yào.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Sức khỏe của bạn tốt thật. Tôi còn từng nằm viện một lần, khám Đông y và cũng đã uống thuốc Đông y.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "爱德华",
          "chinese": "听说中药很苦，是吗？",
          "pinyin": "tīng shuō zhōng yào hěn kǔ， shìma？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Nghe nói thuốc Đông y rất đắng, phải không?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "山本",
          "chinese": "有的苦，有的不苦。我喝的是中成药，甜甜的，一点儿也不苦。吃了这些中药我的病就好了。",
          "pinyin": "yǒu de kǔ， yǒu de bù kǔ. wǒ hē de shìzhōng chéng yào， tián tián de， yī diǎnér yě bù kǔ. chī le zhè xiē zhōng yào wǒ de bìng jiù hǎo le.",
          "pinyinStatus": "generated_icu_han_latin",
