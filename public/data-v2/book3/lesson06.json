  "dialogues": [
    {
      "id": "b3_l06_d01",
      "title": "我是跟旅游团一起来的",
      "lines": [
        {
          "speaker": "丹尼丝",
          "chinese": "王老师，您好！好久不见了。",
          "pinyin": "wáng lǎo shī， nínhǎo！ hǎo jiǔ bù jiàn le.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Thầy Vương, chào thầy! Lâu rồi không gặp.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "王老师",
          "chinese": "你好！丹尼丝，你是什么时候来的？",
          "pinyin": "nǐ hǎo！ dān ní sī， nǐ shìshén me shí hòu lái de？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Chào em! Denise, em đến khi nào vậy?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "丹尼丝",
          "chinese": "前天刚到的。",
          "pinyin": "qián tiān gāng dào de.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Mới đến hôm kia.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "王老师",
          "chinese": "是来学习的吗？",
          "pinyin": "shìlái xué xí de ma？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Đến để học à?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "丹尼丝",
          "chinese": "不是，是来旅行的。",
          "pinyin": "bù shì， shìlái lǚ xíng de.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Không, đến du lịch.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "王老师",
          "chinese": "一个人来的吗？",
          "pinyin": "yī gè rén lái de ma？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Đi một mình à?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "丹尼丝",
          "chinese": "不是，我是跟旅游团一起来的。我当翻译，也是导游。",
          "pinyin": "bù shì， wǒ shìgēn lǚ yóutuán yī qǐ lái de. wǒ dāng fānyì， yě shìdǎo yóu.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Không, em đến cùng đoàn du lịch. Em làm phiên dịch, cũng làm hướng dẫn viên.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "王老师",
          "chinese": "你已经工作了？",
          "pinyin": "nǐ yǐ jīng gōng zuò le？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Em đã đi làm rồi à?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "丹尼丝",
          "chinese": "没有，我还在读研究生。",
          "pinyin": "méi yǒu， wǒ hái zài dú yán jiū shēng.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Chưa, em vẫn đang học cao học.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "王老师",
          "chinese": "是在打工吗？",
          "pinyin": "shìzài dǎ gōng ma？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Là đi làm thêm à?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "丹尼丝",
          "chinese": "是的，利用假期到一家旅行社打工。他们组织了一个旅游团，老板就让我陪他们来了。他知道我需要来中国收集资料，所以，一有来中国的旅游团，他就安排我陪团来。",
          "pinyin": "shìde， lì yòngjiǎ qī dào yī jiā lǚ xíng shèdǎ gōng. tā men zǔ zhī le yī gè lǚ yóutuán， lǎo bǎnjiù ràng wǒ péi tā men lái le. tā zhī dào wǒ xū yào lái zhōng guó shōu jí zī liào， suǒ yǐ， yī yǒu lái zhōng guó de lǚ yóutuán， tā jiù ān pái wǒ péi tuán lái.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Vâng, em tranh thủ kỳ nghỉ làm thêm ở một công ty du lịch. Họ tổ chức một đoàn du lịch, ông chủ bảo em đi cùng họ. Ông ấy biết em cần sang Trung Quốc thu thập tài liệu nên hễ có đoàn nào sang Trung Quốc là lại sắp xếp cho em đi cùng đoàn.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "王老师",
          "chinese": "这个老板还真不错。",
          "pinyin": "zhè gè lǎo bǎnhái zhēn bù cuò.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Ông chủ này quả thật rất tốt.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "丹尼丝",
          "chinese": "是。他给了我很多帮助。",
          "pinyin": "shì. tā gěi le wǒ hěn duō bāng zhù.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Vâng. Ông ấy giúp em rất nhiều.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "王老师",
