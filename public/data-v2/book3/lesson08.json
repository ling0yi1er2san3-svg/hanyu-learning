  "dialogues": [
    {
      "id": "b3_l08_d01",
      "title": "我们的照片洗好了",
      "lines": [
        {
          "speaker": "玛丽",
          "chinese": "我们在长城照的照片洗好了吗？",
          "pinyin": "wǒ men zài zhǎng chéng zhào de zhào piàn xǐ hǎo le ma？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Những bức ảnh chúng ta chụp ở Vạn Lý Trường Thành rửa xong chưa?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "麦克",
          "chinese": "洗好了。",
          "pinyin": "xǐ hǎo le.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Rửa xong rồi.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "照得怎么样？快让我看看。",
          "pinyin": "zhào dé zěn me yàng？ kuài ràng wǒ kàn kàn.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Chụp thế nào? Mau cho tôi xem.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "麦克",
          "chinese": "这些照得非常好，张东的照相技术很不错。这些照得不太好。",
          "pinyin": "zhè xiē zhào dé fēi cháng hǎo， zhāng dōng de zhào xiāngjì shùhěn bù cuò. zhè xiē zhào dé bù tài hǎo.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Mấy tấm này chụp rất đẹp, kỹ thuật chụp ảnh của Trương Đông khá tốt. Mấy tấm này chụp không được đẹp lắm.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "这张也还可以，人照小了一点儿。你再看看这张，眼睛都闭上了，像睡着了一样。",
          "pinyin": "zhè zhāng yě hái kě yǐ， rén zhào xiǎo le yī diǎnér. nǐ zài kàn kàn zhè zhāng， yǎnjīng dōu bì shàng le， xiàng shuì zhe le yī yàng.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Tấm này cũng tạm được, người hơi nhỏ một chút. Bạn xem tấm này nữa, mắt nhắm hết rồi, giống như đang ngủ vậy.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "麦克",
          "chinese": "这张怎么了？",
          "pinyin": "zhè zhāng zěn me le？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Tấm này sao vậy?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "不怎么样。洗得不太好，颜色深了一点儿。这两张洗得最好。像油画一样。",
          "pinyin": "bù zěn me yàng. xǐ dé bù tài hǎo， yán sè shēn le yī diǎnér. zhè liǎng zhāng xǐ dé zuì hǎo. xiàng yóuhuàyī yàng.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Không đẹp lắm. Rửa không tốt, màu hơi đậm. Hai tấm này rửa đẹp nhất, giống tranh sơn dầu vậy.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "麦克",
          "chinese": "再放大两张吧。",
          "pinyin": "zài fàngdà liǎng zhāng ba.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Phóng to thêm hai tấm đi.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "放成多大的？放大一倍怎么样？",
          "pinyin": "fàngchéng duō dà de？ fàngdà yī bèi zěn me yàng？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Phóng cỡ bao nhiêu? Phóng to gấp đôi thế nào?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "麦克",
          "chinese": "放成十公分的就行了。",
          "pinyin": "fàngchéng shí gōng fēn de jiù xíng le.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Phóng cỡ mười xăng-ti-mét là được.",
          "vietnameseStatus": "assistant_translation"
        }
      ],
      "sourceVerified": true
    },
    {
      "id": "b3_l08_d02",
      "title": "我的眼镜摔坏了",
      "lines": [
        {
          "speaker": "小白",
          "chinese": "哎呀，差点儿迟到。",
          "pinyin": "āi ya， chà diǎnér chí dào.",
