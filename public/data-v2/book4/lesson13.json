  "dialogues": [
    {
      "id": "b4_l13_d01",
      "title": "请把护照和机票给我",
      "lines": [
        {
          "speaker": "关建平",
          "chinese": "我们先去办理登机手续，把行李托运了。",
          "pinyin": "wǒ men xiān qù bàn lǐ dēngjīshǒu xù， bǎ xíng lǐ tuō yùn le.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Trước tiên chúng ta đi làm thủ tục lên máy bay rồi gửi hành lý.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "服务员",
          "chinese": "请把护照和机票给我。哪个箱子要托运？把它放上去吧。这是登机牌，请拿好。",
          "pinyin": "qǐng bǎ hù zhào hé jīpiàogěi wǒ. nǎ gè xiāng zǐ yào tuō yùn？ bǎ tā fàngshàng qù ba. zhè shìdēngjīpái， qǐng náhǎo.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Xin đưa hộ chiếu và vé máy bay cho tôi. Va-li nào cần ký gửi? Đặt nó lên đây nhé. Đây là thẻ lên máy bay, xin giữ cẩn thận.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "关建平",
          "chinese": "谢谢。",
          "pinyin": "xiè xiè.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Cảm ơn.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "服务员",
          "chinese": "你口袋里装的是什么？",
          "pinyin": "nǐ kǒu dài lǐ zhuāng de shìshén me？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Trong túi của anh có gì vậy?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "夏雨",
          "chinese": "没有什么呀！",
          "pinyin": "méi yǒu shén me ya！",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Không có gì đâu!",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "服务员",
          "chinese": "请把口袋里的东西都掏出来。",
          "pinyin": "qǐng bǎ kǒu dài lǐ de dōng xī dōu tāo chū lái.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Xin lấy hết đồ trong túi ra.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "夏雨",
          "chinese": "啊，是几把钥匙和两个硬币。",
          "pinyin": "a， shìjǐ bǎ yào shi hé liǎng gè yìngbì.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "À, là mấy chiếc chìa khóa và hai đồng xu.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "服务员",
          "chinese": "好了。请进去吧。",
          "pinyin": "hǎo le. qǐng jìn qù ba.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Được rồi. Xin vào đi.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "关建平",
          "chinese": "把手提包放进行李箱里去吧。",
          "pinyin": "bǎ shǒu tí bāo fàngjìn xíng lǐ xiāng lǐ qù ba.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Cho túi xách tay vào va-li đi.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "夏雨",
          "chinese": "等一下儿，先把相机拿出来，我想在飞机上照两张照片。",
          "pinyin": "děng yī xià ér， xiān bǎ xiāngjīnáchū lái， wǒ xiǎng zài fēi jīshàng zhào liǎng zhāng zhào piàn.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Khoan một chút, lấy máy ảnh ra trước, tôi muốn chụp hai tấm trên máy bay.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "关建平",
          "chinese": "给你。对了，相机里还没有电池呢，我先把电池装上。",
          "pinyin": "gěi nǐ. duì le， xiāngjīlǐ hái méi yǒu diàn chí ne， wǒ xiān bǎ diàn chí zhuāng shàng.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Đây. À đúng rồi, trong máy ảnh vẫn chưa có pin, để tôi lắp pin vào trước.",
          "vietnameseStatus": "assistant_translation"
        }
