  "dialogues": [
    {
      "id": "b4_l16_d01",
      "title": "山这么高，你爬得上去吗",
      "lines": [
        {
          "speaker": "林老师",
          "chinese": "王老师，咱们怎么上山？坐缆车上去还是爬上去？",
          "pinyin": "wáng lǎo shī， zán men zěn me shàng shān？ zuò lǎn chē shàng qù hái shìpáshàng qù？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Thầy Vương, chúng ta lên núi thế nào? Đi cáp treo lên hay leo lên?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "王老师",
          "chinese": "别坐缆车了。跟同学们一起爬上去吧。",
          "pinyin": "bié zuò lǎn chē le. gēn tóng xué men yī qǐ páshàng qù ba.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Đừng đi cáp treo. Cùng các bạn học leo lên đi.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "林老师",
          "chinese": "这座山很高啊，你爬得上去吗？",
          "pinyin": "zhè zuò shān hěn gāo a， nǐ pádé shàng qù ma？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Núi này cao lắm, thầy leo nổi không?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "林老师",
          "chinese": "美英，我看你累得都喘不上气来了，还爬得动吗？",
          "pinyin": "měi yīng， wǒ kàn nǐ lèidé dōu chuǎn bù shàng qì lái le， hái pádé dòng ma？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Mi-young, tôi thấy em mệt đến thở không ra hơi rồi, còn leo nổi không?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "李美英",
          "chinese": "爬得动。",
          "pinyin": "pádé dòng.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Leo được ạ.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "林老师",
          "chinese": "别着急，一步一步地往上爬，爬不动的时候就休息一会儿。走，咱们一起爬，要坚持到底，坚持就是胜利。",
          "pinyin": "bié zhe jí， yī bù yī bù de wǎng shàng pá， pábù dòng de shí hòu jiù xiū xīyī huì ér. zǒu， zán men yī qǐ pá， yào jiān chí dào dǐ， jiān chí jiù shìshèng lì.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Đừng vội, cứ từng bước từng bước leo lên; khi không leo nổi thì nghỉ một lát. Đi, chúng ta cùng leo, phải kiên trì đến cùng; kiên trì chính là thắng lợi.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "王老师",
          "chinese": "刚爬一会儿就出了一身汗，我休息一会儿再接着爬，比不了你们年轻人啦。",
          "pinyin": "gāng páyī huì ér jiù chū le yī shēn hàn， wǒ xiū xīyī huì ér zài jiē zhe pá， bǐ bù le nǐ men nián qīng rén la.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Mới leo một lúc đã toát mồ hôi khắp người, tôi nghỉ một chút rồi leo tiếp. Tôi không thể so với lớp trẻ các em được nữa rồi.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "李美英",
          "chinese": "啊，看，王老师也爬上来了。",
          "pinyin": "a， kàn， wáng lǎo shī yě páshàng lái le.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "A, nhìn kìa, thầy Vương cũng leo lên rồi.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "王老师",
          "chinese": "麦克，别从那儿上，太危险了。要注意安全。",
          "pinyin": "mài kè， bié cóng nà ér shàng， tài wēi xiǎn le. yào zhùyì ān quán.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Mike, đừng lên từ chỗ đó, nguy hiểm lắm. Phải chú ý an toàn.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "麦克",
          "chinese": "知道了。",
          "pinyin": "zhī dào le.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Em biết rồi.",
          "vietnameseStatus": "assistant_translation"
        }
      ],
      "sourceVerified": true
    },
    {
      "id": "b4_l16_d02",
      "title": "我担心自己演不好",
      "lines": [
        {
          "speaker": "林老师",
          "chinese": "爱德华，咱们班参加联欢会的节目准备得怎么样了？",
          "pinyin": "ài dé huá， zán men bāncān jiā lián huān huì de jié mùzhǔn bèi dé zěn me yàng le？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Edward, tiết mục lớp mình tham gia liên hoan chuẩn bị thế nào rồi?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "爱德华",
          "chinese": "大家都在积极地准备呢。",
          "pinyin": "dà jiā dōu zài jījí de zhǔn bèi ne.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Mọi người đều đang tích cực chuẩn bị ạ.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "林老师",
          "chinese": "你表演什么节目？",
          "pinyin": "nǐ biǎo yǎn shén me jié mù？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Em biểu diễn tiết mục gì?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "爱德华",
          "chinese": "我和麦克说个相声。可是总记不住台词，正背台词呢。",
          "pinyin": "wǒ hé mài kè shuō gè xiāngshēng. kě shìzǒngjì bù zhù tái cí， zhèng bèi tái cí ne.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Em với Mike diễn tấu hài. Nhưng cứ không nhớ nổi lời thoại nên đang học thuộc đây.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "林老师",
          "chinese": "背会了吗？",
          "pinyin": "bèi huì le ma？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Thuộc chưa?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "爱德华",
          "chinese": "快了。山本，你们的小话剧呢？",
          "pinyin": "kuài le. shān běn， nǐ men de xiǎo huà jù ne？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Sắp rồi. Yamamoto, vở kịch ngắn của các bạn thế nào?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "山本",
          "chinese": "我们也正在排练呢。有的音我发不准，我请田芳一句一句地给我纠正。",
          "pinyin": "wǒ men yě zhèng zài pái liàn ne. yǒu de yīn wǒ fā bù zhǔn， wǒ qǐng tián fāng yī jù yī jù de gěi wǒ jiū zhèng.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Bọn em cũng đang tập. Có vài âm em phát không chuẩn, em nhờ Điền Phương sửa cho từng câu một.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "林老师",
          "chinese": "谁跟你一起表演？",
          "pinyin": "shéi gēn nǐ yī qǐ biǎo yǎn？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Ai biểu diễn cùng em?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "山本",
          "chinese": "原来是玛丽，可是玛丽的腿受伤了，参加不了了。我请罗兰跟我一起表演。",
          "pinyin": "yuán lái shìmǎ lì， kě shìmǎ lì de tuǐ shòu shāng le， cān jiā bù le le. wǒ qǐng luó lán gēn wǒ yī qǐ biǎo yǎn.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Ban đầu là Mary, nhưng chân Mary bị thương nên không tham gia được. Em nhờ Roland diễn cùng.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "罗兰",
          "chinese": "我担心自己演不好。",
          "pinyin": "wǒ dān xīn zì jǐ yǎn bù hǎo.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Tôi lo mình diễn không tốt.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "林老师",
          "chinese": "要有自信，相信自己能演好。",
          "pinyin": "yào yǒu zì xìn， xiāngxìn zì jǐ néng yǎn hǎo.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Phải tự tin, tin rằng mình có thể diễn tốt.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "山本",
          "chinese": "只要我们好好儿练，就一定能演好。“世上无难事，只怕有心人”嘛！",
          "pinyin": "zhǐ yào wǒ men hǎo hǎo ér liàn， jiù yī dìng néng yǎn hǎo.“shì shàng wú nán shì， zhǐ pà yǒu xīn rén” ma！",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Chỉ cần chúng ta luyện tập nghiêm túc thì nhất định sẽ diễn tốt. ‘Trên đời không có việc khó, chỉ sợ người có lòng’ mà!",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "罗兰",
          "chinese": "我一定努力，争取演出成功。",
          "pinyin": "wǒ yī dìng nǔ lì， zhēng qǔ yǎn chū chéng gōng.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Em nhất định sẽ cố gắng, phấn đấu để biểu diễn thành công.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "山本",
          "chinese": "老师，您也给我们表演个节目吧。",
          "pinyin": "lǎo shī， nínyě gěi wǒ men biǎo yǎn gè jié mùba.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Thầy ơi, thầy cũng biểu diễn cho chúng em một tiết mục nhé.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "林老师",
          "chinese": "我准备了一首歌，不过，很长时间没唱了，恐怕唱不好。",
          "pinyin": "wǒ zhǔn bèi le yī shǒu gē， bù guò， hěn zhǎng shí jiān méi chàng le， kǒng pà chàng bù hǎo.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Tôi chuẩn bị một bài hát, nhưng lâu lắm rồi không hát, e là hát không hay.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "山本",
          "chinese": "这个地方这么小，坐得下二百多人吗？",
          "pinyin": "zhè gè de fāngzhè me xiǎo， zuò dé xià èr bǎiduō rén ma？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Chỗ này nhỏ thế, chứa nổi hơn hai trăm người không?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "林老师",
          "chinese": "联欢会在楼下小礼堂举行，那儿能坐下三四百人呢。",
          "pinyin": "lián huān huì zài lóuxià xiǎo lǐtáng jǔ xíng， nà ér néng zuò xià sān sì bǎirén ne.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Buổi liên hoan tổ chức ở hội trường nhỏ dưới tầng, nơi đó chứa được ba bốn trăm người.",
          "vietnameseStatus": "assistant_translation"
        }
      ],
