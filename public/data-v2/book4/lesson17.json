  "dialogues": [
    {
      "id": "b4_l17_d01",
      "title": "我想起来了",
      "lines": [
        {
          "speaker": "海伦",
          "chinese": "喂，是王老师吗？",
          "pinyin": "wèi， shìwáng lǎo shī ma？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "A lô, có phải thầy Vương không ạ?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "王老师",
          "chinese": "是，你是……",
          "pinyin": "shì， nǐ shì……",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Vâng, em là...",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "海伦",
          "chinese": "老师，你听得出来我是谁吗？",
          "pinyin": "lǎo shī， nǐ tīng dé chū lái wǒ shìshéi ma？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Thầy có nghe ra em là ai không?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "王老师",
          "chinese": "你是……对不起，声音有点儿熟，但一下子想不起来是谁了。",
          "pinyin": "nǐ shì……duì bù qǐ， shēng yīn yǒu diǎnér shú， dàn yī xià zǐ xiǎng bù qǐ lái shìshéi le.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Em là... xin lỗi, giọng nghe hơi quen nhưng nhất thời thầy không nhớ ra là ai.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "海伦",
          "chinese": "我是你三年前的学生，老师还参加过我的婚礼呢。",
          "pinyin": "wǒ shìnǐ sān nián qián de xué shēng， lǎo shī hái cān jiā guò wǒ de hūn lǐne.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Em là học sinh của thầy ba năm trước, thầy còn từng dự đám cưới của em mà.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "王老师",
          "chinese": "啊，我想起来了，海伦！你现在在哪儿？",
          "pinyin": "a， wǒ xiǎng qǐ lái le， hǎi lún！ nǐ xiàn zài zài nǎ ér？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "À, thầy nhớ ra rồi, Helen! Bây giờ em ở đâu?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "海伦",
          "chinese": "我就在北京。",
          "pinyin": "wǒ jiù zài běi jīng.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Em đang ở Bắc Kinh.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "王老师",
          "chinese": "你是怎么知道这个电话号码的？",
          "pinyin": "nǐ shìzěn me zhī dào zhè gè diàn huà hào mǎ de？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Sao em biết số điện thoại này?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "海伦",
          "chinese": "是罗兰告诉我的。",
          "pinyin": "shìluó lán gào sù wǒ de.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Roland nói cho em biết.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "王老师",
          "chinese": "是吗？你是来旅行的吗？",
          "pinyin": "shìma？ nǐ shìlái lǚ xíng de ma？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Thế à? Em đến du lịch à?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "海伦",
          "chinese": "不是。我是应国际广播电台的邀请来北京工作的。",
          "pinyin": "bù shì. wǒ shìyīng guó jì guǎng bōdiàn tái de yāo qǐng lái běi jīng gōng zuò de.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Không ạ. Em được Đài Phát thanh Quốc tế mời đến Bắc Kinh làm việc.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "王老师",
          "chinese": "要呆多长时间？",
          "pinyin": "yào dāi duō zhǎng shí jiān？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Ở bao lâu?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "海伦",
          "chinese": "我跟他们签了两年的合同。",
          "pinyin": "wǒ gēn tā men qiānle liǎng nián de hé tóng.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Em ký hợp đồng hai năm với họ.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "王老师",
          "chinese": "保罗呢？",
          "pinyin": "bǎo luó ne？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Paul thì sao?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "海伦",
          "chinese": "保罗也来了。他在北京的一家中外合资公司工作。老师，我们想请您来我家做客。",
          "pinyin": "bǎo luó yě lái le. tā zài běi jīng de yī jiā zhōng wài hé zī gōng sī gōng zuò. lǎo shī， wǒ men xiǎng qǐng nínlái wǒ jiā zuò kè.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Paul cũng đến rồi. Anh ấy làm việc tại một công ty liên doanh Trung - nước ngoài ở Bắc Kinh. Thầy ơi, chúng em muốn mời thầy đến nhà chơi.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "王老师",
          "chinese": "好啊。",
          "pinyin": "hǎo a.",
