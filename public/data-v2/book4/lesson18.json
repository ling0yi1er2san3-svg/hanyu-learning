  "dialogues": [
    {
      "id": "b4_l18_d01",
      "title": "吃什么都可以",
      "lines": [
        {
          "speaker": "麦克",
          "chinese": "我有点儿饿了，想吃点儿什么，你呢？",
          "pinyin": "wǒ yǒu diǎnér è le， xiǎng chī diǎnér shén me， nǐ ne？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Tôi hơi đói, muốn ăn gì đó, còn bạn?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "我又饿又渴。咱们去饭馆吧。",
          "pinyin": "wǒ yòu è yòu kě. zán men qù fàn guǎn ba.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Tôi vừa đói vừa khát. Chúng ta đi nhà hàng đi.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "麦克",
          "chinese": "你吃点儿什么？",
          "pinyin": "nǐ chī diǎnér shén me？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Bạn muốn ăn gì?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "你点吧，什么都可以。",
          "pinyin": "nǐ diǎnba， shén me dōu kě yǐ.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Bạn gọi món đi, gì cũng được.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "服务员",
          "chinese": "你们两位要点儿什么？",
          "pinyin": "nǐ men liǎng wèi yào diǎnér shén me？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Hai vị muốn gọi món gì?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "麦克",
          "chinese": "小姐，你们这儿有什么好吃的菜？什么好吃我们就吃什么。",
          "pinyin": "xiǎo jiě， nǐ men zhè ér yǒu shén me hǎo chī de cài？ shén me hǎo chī wǒ men jiù chī shén me.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Cô ơi, ở đây có món nào ngon? Món gì ngon thì chúng tôi ăn món đó.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "服务员",
          "chinese": "我们这儿什么菜都好吃啊。",
          "pinyin": "wǒ men zhè ér shén me cài dōu hǎo chī a.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Ở đây món nào cũng ngon mà.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "麦克",
          "chinese": "是吗？把你们这儿最好吃的菜给我们来两个。",
          "pinyin": "shìma？ bǎ nǐ men zhè ér zuì hǎo chī de cài gěi wǒ men lái liǎng gè.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Thế à? Mang cho chúng tôi hai món ngon nhất ở đây.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "服务员",
          "chinese": "这儿的辣子鸡丁和糖醋鱼都不错。",
          "pinyin": "zhè ér de là zǐ jī dīng hé táng cù yú dōu bù cuò.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Gà xào ớt và cá chua ngọt ở đây đều khá ngon.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "麦克",
          "chinese": "那就一样来一个吧。我们喝点儿什么呢？",
          "pinyin": "nà jiù yī yàng lái yī gè ba. wǒ men hē diǎnér shén me ne？",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Vậy mỗi món một phần nhé. Chúng ta uống gì?",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "玛丽",
          "chinese": "随便。你说喝什么就喝什么吧。",
          "pinyin": "suí biàn. nǐ shuō hē shén me jiù hē shén me ba.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Tùy. Bạn nói uống gì thì uống cái đó.",
          "vietnameseStatus": "assistant_translation"
        }
      ],
      "sourceVerified": true
    },
    {
      "id": "b4_l18_d02",
      "title": "你是哪儿冷去哪儿啊",
      "lines": [
        {
          "speaker": "田中",
          "chinese": "时间过得真快，下周考完试就要放寒假了。",
          "pinyin": "shí jiān guò dé zhēn kuài， xià zhōu kǎo wán shì jiù yào fànghán jiǎ le.",
          "pinyinStatus": "generated_icu_han_latin",
          "vietnamese": "Thời gian trôi nhanh thật, tuần sau thi xong là nghỉ đông rồi.",
          "vietnameseStatus": "assistant_translation"
        },
        {
          "speaker": "麦克",
          "chinese": "是啊，寒假你有什么打算吗？",
